# =============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your deployment environment.
# =============================================================================

# Flask Application Mode ('development', 'testing', 'production')
FLASK_ENV=development

# Application Security Keys (Generate strong 64-character random strings in production)
SECRET_KEY=your-flask-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database Connection URI
# Local development default: sqlite:///campus_simulation.db
# Cloud PostgreSQL example: postgresql://username:password@localhost:5432/campus_db
DATABASE_URL=sqlite:///campus_simulation.db

# CORS Allowed Origins (Comma-separated for multi-origin, or * for open development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port Configuration
PORT=5000
VITE_API_URL=http://localhost:5000/api
